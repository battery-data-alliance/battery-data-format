{
  "$defs": {
    "ChannelIri": {
      "pattern": "^https://w3id\\.org/battinfo/channel/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "type": "string"
    },
    "EquipmentIri": {
      "pattern": "^https://w3id\\.org/battinfo/equipment/[0-9a-hjkmnp-tv-z]{4}(?:-[0-9a-hjkmnp-tv-z]{4}){3}$",
      "type": "string"
    },
    "Handle": {
      "description": "Short readable slug for this record, unique within one registry workspace and shown as <workspace>/<handle> (e.g. 'flores-ocv/graphite-aq-1-063b77-cell'). Lowercase ASCII segments joined by '/', each made of letters and digits separated by single hyphens; at most 120 characters. Display text only: the record's identity is its IRI, and a handle may be corrected without moving it. Build one with battinfo.naming.handle_for().",
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "battinfo_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
          "type": "string"
        },
        "citation": {
          "format": "uri",
          "type": "string"
        },
        "citation_doi": {
          "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$",
          "type": "string"
        },
        "retrieved_at": {
          "$ref": "#/$defs/UnixTime"
        },
        "source_file": {
          "type": "string"
        },
        "source_name": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "datasheet",
            "manufacturer",
            "measurement",
            "lab",
            "literature",
            "manual",
            "other"
          ],
          "type": "string"
        },
        "source_url": {
          "oneOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_type"
      ],
      "type": "object"
    },
    "ShortId": {
      "pattern": "^[0-9a-hjkmnp-tv-z]{6,16}$",
      "type": "string"
    },
    "UnixTime": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "$id": "https://w3id.org/battinfo/schema/channel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One channel of one physical equipment unit. Instance-only (no channel-spec kind): flat IRIs under channel/, parent link equipment_id in the record body, uid minted deterministically from (equipment uid, index).",
  "license": "https://www.apache.org/licenses/LICENSE-2.0",
  "properties": {
    "channel": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "type": "string"
        },
        "equipment_id": {
          "$ref": "#/$defs/EquipmentIri"
        },
        "handle": {
          "$ref": "#/$defs/Handle",
          "description": "Short readable slug, unique within one registry workspace (e.g. 'flores-ocv/graphite-aq-1-063b77-cell'). Display text, never part of the identity."
        },
        "id": {
          "$ref": "#/$defs/ChannelIri"
        },
        "index": {
          "minimum": 1,
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "property": {
          "$ref": "modules/common/quantitative-properties.schema.json"
        },
        "short_id": {
          "$ref": "#/$defs/ShortId"
        },
        "status": {
          "enum": [
            "active",
            "maintenance",
            "retired",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "equipment_id",
        "index"
      ],
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "channel",
    "provenance"
  ],
  "title": "BattINFO Channel Instance",
  "type": "object"
}
